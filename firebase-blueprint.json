{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents an authenticated user profile (creator or brand)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "phoneNumber": { "type": "string", "description": "Verified mobile phone number with country code" },
        "role": { "type": "string", "enum": ["creator", "sponsor", "admin"], "description": "User role in platform" },
        "displayName": { "type": "string", "description": "User display name" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of profile creation" }
      },
      "required": ["uid", "phoneNumber", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document stored under users collection"
    }
  }
}
