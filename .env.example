# ============================================================================
# 1. SERVER & SECURITY (Auto-configured in render.yaml / Pre-set defaults)
# ============================================================================
PORT=3000
NODE_ENV=production
JWT_SECRET=
TOKEN_ENC_KEY=
ADMIN_EMAIL=admin@mingree.com
ADMIN_PASSWORD=

# ============================================================================
# 2. PENDING KEYS (To be added by you on Render)
# ============================================================================
# A. Render PostgreSQL Internal Database URL
DATABASE_URL=

# B. Your Domain / Render URL (e.g. https://mingree.com)
APP_URL=

# C. Email OTP Service (100% Free via Gmail App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# D. Cashfree Payment Gateway (For Wallet Top-ups)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_MODE=PRODUCTION

# E. Instagram Meta Graph API (Optional - For Official OAuth Verification)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ============================================================================
# 3. PLATFORM BUSINESS RULES (Already Done - Pre-set in Code & render.yaml)
# ============================================================================
FEE_ARTIST_PERCENT=7.5
FEE_CREATOR_PERCENT=7.5
FEE_CREATOR_PERCENT_PRO=4
CREATOR_PRO_PRICE=399
GST_PERCENT=18
MIN_CREATOR_FOLLOWERS=5000
MIN_CREATOR_WITHDRAWAL=500
MIN_ARTIST_WITHDRAWAL=1000
REVIEW_WINDOW_HOURS=72
LIVE_HOLD_DAYS=7
RELEASE_FIRST_PERCENT=100
RATE_CHANGE_COOLDOWN_DAYS=7
MAX_BUDGET_SHARE_PER_CREATOR=30
MIN_DEAL_AMOUNT=300
BENCHMARK_CPM_MIN=50
BENCHMARK_CPM_MAX=300
