# ============================================================================
# MINGREE PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env or configure in your deployment platform's Secrets.
# Never commit real credentials or secrets to version control.
# ============================================================================

# 1. APPLICATION ENVIRONMENT & URL
NODE_ENV=production
PORT=3000
APP_URL=https://mingree.com

# 2. CANONICAL DATABASE (PostgreSQL / Neon Free Tier)
# Use your Neon pooled connection string (with ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# 3. AUTHENTICATION & SENSITIVE DATA ENCRYPTION
# Generate random 64-character hex strings: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
TOKEN_ENC_KEY=your_token_enc_key_at_least_32_characters_long

# 4. CLOUDFLARE R2 OBJECT STORAGE (Zero Egress Cost)
# Created in Cloudflare Dashboard -> R2 -> Create Bucket
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=mingree-assets
R2_PUBLIC_URL=https://pub-your-id.r2.dev

# 5. CASHFREE PAYMENTS (UPI, Cards, NetBanking)
# Set to 'production' for live payments or 'sandbox' for test mode
CASHFREE_MODE=production
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# 6. INSTAGRAM META BUSINESS OAUTH
# Configured in Meta for Developers -> App Dashboard -> Instagram Basic Display
INSTAGRAM_APP_ID=your_meta_instagram_app_id
INSTAGRAM_APP_SECRET=your_meta_instagram_app_secret

# 7. EMAIL DELIVERY (Transactional OTP & Notifications)
GMAIL_USER=notifications@mingree.com
GMAIL_APP_PASSWORD=your_gmail_16_char_app_password

# 8. SMS DELIVERY (Optional)
FAST2SMS_API_KEY=your_fast2sms_api_key

# 9. INITIAL ADMIN ACCOUNT
ADMIN_EMAIL=admin@mingree.com
ADMIN_PASSWORD=your_secure_admin_password

# 10. MINGREE PLATFORM PARAMETERS
GST_PERCENT=18
FEE_ARTIST_PERCENT=5
FEE_CREATOR_PERCENT=10
FEE_CREATOR_PERCENT_PRO=5
CREATOR_PRO_PRICE=499
MIN_DEAL_AMOUNT=500
MIN_CREATOR_WITHDRAWAL=500
MIN_ARTIST_WITHDRAWAL=1000
BENCHMARK_CPM_MIN=20
BENCHMARK_CPM_MAX=80
REVIEW_WINDOW_HOURS=48
LIVE_HOLD_DAYS=7
RATE_CHANGE_COOLDOWN_DAYS=7
MAX_BUDGET_SHARE_PER_CREATOR=40
MIN_CREATOR_FOLLOWERS=1000