{
  "version": 2,
  "buildCommand": "npm run build",
  "builds": [
    {
      "src": "dist/server.cjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "dist/**",
          "app_settings.json",
          "user_profile.json"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/server.cjs"
    }
  ]
}
