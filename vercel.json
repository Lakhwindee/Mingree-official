{
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "dist/server.cjs": {
      "includeFiles": [
        "dist/**",
        "app_settings.json",
        "user_profile.json"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/dist/server.cjs"
    }
  ]
}
