rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasRestrictedUserFields() {
      return request.resource.data.keys().hasAny([
        'role', 'isAdmin', 'balance', 'escrowHeld', 'isInstagramVerified', 'tier', 'status'
      ]);
    }

    function isRestrictedFieldModified() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'isAdmin', 'balance', 'escrowHeld', 'isInstagramVerified', 'tier', 'status'
      ]);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && !hasRestrictedUserFields();
      allow update: if isOwner(userId) && isValidId(userId) && !isRestrictedFieldModified();
      allow delete: if false;
    }

    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }
  }
}
